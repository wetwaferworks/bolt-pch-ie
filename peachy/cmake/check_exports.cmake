# The Peachy library must export exactly one symbol: peachy_get_api.
if(DUMPBIN)
  execute_process(COMMAND ${DUMPBIN} /nologo /exports ${LIB} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "dumpbin failed: ${_rc}")
  endif()
  # export lines look like: "    1    0 00001234 peachy_get_api"
  string(REGEX MATCHALL "\n +[0-9]+ +[0-9A-F]+ +[0-9A-F]+ +[A-Za-z_][A-Za-z0-9_@?]*" _lines "${_out}")
  set(_syms "")
  foreach(l ${_lines})
    string(REGEX REPLACE ".* ([A-Za-z_][A-Za-z0-9_@?]*)$" "\\1" s "${l}")
    list(APPEND _syms ${s})
  endforeach()
else()
  execute_process(COMMAND ${NM} -D --defined-only ${LIB} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "nm failed: ${_rc}")
  endif()
  string(REGEX MATCHALL "[0-9a-f]+ [TDBRW] [A-Za-z_][A-Za-z0-9_]*" _lines "${_out}")
  set(_syms "")
  foreach(l ${_lines})
    string(REGEX REPLACE ".* ([A-Za-z_][A-Za-z0-9_]*)$" "\\1" s "${l}")
    if(NOT s MATCHES "^_(init|fini|edata|end|bss_start)$" AND NOT s MATCHES "^__")
      list(APPEND _syms ${s})
    endif()
  endforeach()
endif()
if(NOT _syms STREQUAL "peachy_get_api")
  message(FATAL_ERROR "exports are '${_syms}', expected exactly peachy_get_api")
endif()
message(STATUS "exports: ${_syms}")
