# Peachy has no locks of any kind: fail if a lock primitive shows up in the library or the host tool.
file(GLOB_RECURSE _files ${ROOT}/src/*.c ${ROOT}/src/*.h ${ROOT}/include/*.h ${ROOT}/tools/*.c)
set(_bad "")
foreach(f ${_files})
  file(STRINGS ${f} _hits REGEX "[Mm]utex|MUTEX|lock_guard|unique_lock|CRITICAL_SECTION|EnterCriticalSection|SRWLOCK|AcquireSRW|pthread_rwlock|pthread_spin|sem_wait|WaitForSingleObject\\(.*[Mm]utex|std::lock")
  if(_hits)
    list(APPEND _bad "${f}: ${_hits}")
  endif()
endforeach()
list(LENGTH _files _n)
if(_bad)
  message(FATAL_ERROR "lock primitives found:\n${_bad}")
endif()
message(STATUS "no locks in ${_n} files")
